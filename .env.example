# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Hardware ----
# "mock"  = simulate everything in the browser (no hardware needed)
# "live"  = use real drivers (scanner/printer/drawer/Yoco)
NEXT_PUBLIC_HARDWARE_MODE=mock

# ---- Yoco (only needed when HARDWARE_MODE=live) ----
YOCO_SECRET_KEY=
NEXT_PUBLIC_YOCO_PUBLIC_KEY=

# ---- Store identity for this terminal ----
NEXT_PUBLIC_STORE_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_TILL_ID=22222222-2222-2222-2222-222222222201

# ---- Receipt email ----
# "mock" = pretend to send (no provider needed)
# "live" = POST to /api/receipts/email, which talks to your provider
NEXT_PUBLIC_RECEIPT_EMAIL_MODE=mock
RECEIPT_EMAIL_API_KEY=
